{
  "name": "enosx-browser",
  "version": "0.1.0",
  "description": "A private, focused, offline-ready browser shell with Enosx AI.",
  "private": true,
  "author": {
    "name": "Enosx Technologies",
    "email": "hello@enosx.tech"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:web": "next build",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "pnpm build:web && electron-builder",
    "installer:linux": "pnpm build:web && electron-builder --linux AppImage deb",
    "installer:windows": "pnpm build:web && electron-builder --win nsis",
    "installer:mac": "pnpm build:web && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.enosx.browser",
    "productName": "Enosx Browser",
    "artifactName": "Enosx-Browser-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "Enosx Technologies <hello@enosx.tech>"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  }
}
