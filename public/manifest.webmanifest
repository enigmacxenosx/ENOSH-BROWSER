{
  "name": "Enosx Browser",
  "short_name": "Enosx",
  "description": "A private, focused, offline-ready browser shell with Enosx AI.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
